{
    "version": "0.3.0",
    "configurations": [
        {
            "name": "Debug Nachos (Custom Flags)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}${pathSeparator}${input:nachosExecutable}",
            "args": [
                "${input:commandArgs}"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}${pathSeparator}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ],
    "inputs": [
        {
            "id": "nachosExecutable",
            "type": "promptString",
            "description": "Select the NachOS executable to run. Paths are relative to the root of the workspace.",
            "default": "filesys/nachos"
        },
        {
            "id": "commandArgs",
            "type": "promptString",
            "description": "Enter Nachos command line arguments. Paths are relative to the root of the workspace. (e.g. '-x filesys/test/big' or '-x test/sort')",
            "default": ""
        }
    ]
}