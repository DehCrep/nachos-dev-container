# .gitignore specifically tailored for the NachOS environment
# Place it in the workspace folder, next to the .devcontainer and .vscode folders

# Ignore all files without an extension
*
!*/
!*.*

# Ignore all .o files (generated by makefile)
*.o

# Ignore Disk
DISK

# Ignore this file
threads/.tnatr^%fnmap

# Ignore vscode specific folders
.devcontainer
.vscode

# Unignore important files.
!Makefile
!setup_env
!filesys/**/small
!filesys/**/medium
!filesys/**/big
!filesys/wipe
!test/script
!test/script_linux
!test/script_sun